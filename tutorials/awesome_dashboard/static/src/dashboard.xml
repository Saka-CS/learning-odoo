<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="awesome_dashboard.AwesomeDashboard">
    <button
      class="btn btn-primary"
      t-on-click="openCustomers"
    >Customers</button>
    <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
    <Layout className="'o_dashboard h-100'" display="{ controlPanel: {} }">
      Hello World
      <div class="d-flex gap-3">
        <DashboardItem>This is a test</DashboardItem>
        <DashboardItem size="2">This is a test for double size</DashboardItem>
        <DashboardItem><h3
          >The average amount of T-shirt by order this month</h3><t
            t-esc="this.statistics.average_quantity"
          /></DashboardItem>
        <DashboardItem><h3>The average amount of time an order takes</h3><t
            t-esc="this.statistics.average_time"
          /></DashboardItem>
        <DashboardItem><h3>The number of cancelled orders</h3><t
            t-esc="this.statistics.nb_cancelled_orders"
          /></DashboardItem>
        <DashboardItem><h3>The number of new orders</h3><t
            t-esc="this.statistics.nb_new_orders"
          /></DashboardItem>
        <DashboardItem><h3>Total amount of all orders</h3><t
            t-esc="this.statistics.total_amount"
          /></DashboardItem>
      </div>
    </Layout>
  </t>

</templates>
